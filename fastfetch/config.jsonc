{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/about.txt",
    "color": {
      "1": "#22d3ee",
      "2": "#f472b6"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;244;114;182m┌──────────────────────\u001b[38;2;34;211;238mHardware\u001b[38;2;244;114;182m──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "#f472b6"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "#f472b6"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "#f472b6"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "#f472b6"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "#f472b6"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "#f472b6"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "#f472b6"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;244;114;182m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;244;114;182m┌──────────────────────\u001b[38;2;34;211;238mSoftware\u001b[38;2;244;114;182m──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "#22d3ee",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "#22d3ee",
      "text": "branch=$(omarchy-version-branch); echo \"$branch\""
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "#22d3ee",
      "text": "channel=$(omarchy-version-channel); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#22d3ee"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "#22d3ee"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "#22d3ee"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#22d3ee"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#22d3ee"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#22d3ee"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "#22d3ee",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "#22d3ee"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;244;114;182m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;244;114;182m┌────────────────\u001b[38;2;34;211;238mAge / Uptime / Update\u001b[38;2;244;114;182m───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "#c084fc",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "#c084fc"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "#c084fc",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;244;114;182m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
